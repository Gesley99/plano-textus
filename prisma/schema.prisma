generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN COLABORADOR }
enum ClientStatus { NOVO EM_ATENDIMENTO ATIVO FINALIZADO INATIVO }
enum OrderStatus { ORCAMENTO AGUARDANDO_PAGAMENTO EM_PRODUCAO EM_REVISAO ENTREGUE FINALIZADO CANCELADO }
enum Priority { BAIXA MEDIA ALTA URGENTE }
enum TransactionType { ENTRADA SAIDA }
enum TransactionStatus { PAGO PENDENTE ATRASADO CANCELADO }

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  documents Document[]
  activities ActivityLog[]
  transactionsCreated FinancialTransaction[]
}


model ServiceType {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  clients Client[]
  orders Order[]
}

model Client {
  id String @id @default(cuid())
  fullName String
  whatsapp String
  email String?
  course String?
  institution String?
  cityState String?
  notes String?
  status ClientStatus @default(NOVO)
  serviceTypeId String?
  serviceType ServiceType? @relation(fields:[serviceTypeId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  documents Document[]
  transactions FinancialTransaction[]
}

model Order {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields:[clientId], references:[id])
  serviceTypeId String
  serviceType ServiceType @relation(fields:[serviceTypeId], references:[id])
  title String
  description String?
  totalValue Decimal @db.Decimal(10,2)
  paidValue Decimal @default(0) @db.Decimal(10,2)
  remainingValue Decimal @db.Decimal(10,2)
  paymentMethod String?
  entryDate DateTime
  dueDate DateTime
  status OrderStatus @default(ORCAMENTO)
  priority Priority @default(MEDIA)
  ownerId String?
  owner User? @relation(fields:[ownerId], references:[id])
  internalNotes String?
  hasPlagiarismReport Boolean @default(false)
  hasAntiAiCheck Boolean @default(false)
  hasAbntFormatting Boolean @default(false)
  hasSlides Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  transactions FinancialTransaction[]
  payments Payment[]
}

model Category {
  id String @id @default(cuid())
  name String @unique
  createdAt DateTime @default(now())
  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id String @id @default(cuid())
  type TransactionType
  description String
  value Decimal @db.Decimal(10,2)
  date DateTime
  paymentMethod String?
  clientId String?
  client Client? @relation(fields:[clientId], references:[id])
  orderId String?
  order Order? @relation(fields:[orderId], references:[id])
  categoryId String
  category Category @relation(fields:[categoryId], references:[id])
  status TransactionStatus @default(PENDENTE)
  notes String?
  createdById String?
  createdBy User? @relation(fields:[createdById], references:[id])
  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  value Decimal @db.Decimal(10,2)
  dueDate DateTime
  paidAt DateTime?
  status TransactionStatus @default(PENDENTE)
  createdAt DateTime @default(now())
}

model Document {
  id String @id @default(cuid())
  name String
  type String
  category String
  path String
  clientId String
  client Client @relation(fields:[clientId], references:[id])
  orderId String?
  order Order? @relation(fields:[orderId], references:[id])
  uploadedById String
  uploadedBy User @relation(fields:[uploadedById], references:[id])
  notes String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id String @id @default(cuid())
  action String
  entityType String
  entityId String
  metadata Json?
  userId String
  user User @relation(fields:[userId], references:[id])
  createdAt DateTime @default(now())
}
